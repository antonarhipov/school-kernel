{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://school-kernel.invalid/schema/school-definition-v1.schema.json",
  "title": "School Kernel school definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "catalogVersion", "schoolId", "displayName", "subjects", "teachers",
    "cohorts", "rooms", "periods", "lessons"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "catalogVersion": { "enum": [1, 2, 3, 4, 5, 6, 7, 8, 9] },
    "schoolId": { "$ref": "#/$defs/id" },
    "displayName": { "$ref": "#/$defs/displayName" },
    "basedOnRevision": { "$ref": "#/$defs/revision" },
    "subjects": { "type": "array", "items": { "$ref": "#/$defs/subject" } },
    "teachers": { "type": "array", "items": { "$ref": "#/$defs/teacher" } },
    "cohorts": { "type": "array", "items": { "$ref": "#/$defs/cohort" } },
    "rooms": { "type": "array", "items": { "$ref": "#/$defs/room" } },
    "periods": { "type": "array", "items": { "$ref": "#/$defs/period" } },
    "reservedPeriodIds": { "$ref": "#/$defs/idArray" },
    "lessons": { "type": "array", "items": { "$ref": "#/$defs/lesson" } },
    "roomAssignments": { "type": "array", "items": { "$ref": "#/$defs/roomAssignment" } },
    "softConstraintOverrides": {
      "type": "array",
      "items": { "$ref": "#/$defs/softConstraintOverride" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "idArray": {
      "type": "array",
      "items": { "$ref": "#/$defs/id" },
      "uniqueItems": true
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "displayName": { "$ref": "#/$defs/displayName" },
        "reservedPeriodsAllowed": { "type": "boolean" },
        "maxWeeklyReservedLessonsPerCohort": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "dayEdgeOnly": { "type": "boolean" },
        "maxDailyLessonsPerCohort": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "curatorLesson": { "type": "boolean" }
      },
      "if": { "required": ["maxWeeklyReservedLessonsPerCohort"] },
      "then": {
        "required": ["reservedPeriodsAllowed"],
        "properties": { "reservedPeriodsAllowed": { "const": true } }
      }
    },
    "teacher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName", "qualifiedSubjectIds"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "displayName": { "$ref": "#/$defs/displayName" },
        "qualifiedSubjectIds": { "$ref": "#/$defs/idArray" },
        "availablePeriodIds": { "$ref": "#/$defs/idArray" },
        "undesirablePeriodIds": { "$ref": "#/$defs/idArray" }
      }
    },
    "cohort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName", "size"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "displayName": { "$ref": "#/$defs/displayName" },
        "size": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "availablePeriodIds": { "$ref": "#/$defs/idArray" },
        "undesirablePeriodIds": { "$ref": "#/$defs/idArray" },
        "maxDailyLessonSpread": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "maxDailyGaps": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "latestStartSlot": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "preferredLatestStartSlot": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "dailyLessonSpreadLimit": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "curatorTeacherId": { "$ref": "#/$defs/id" },
        "homeRoomId": { "$ref": "#/$defs/id" }
      }
    },
    "room": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName", "capacity", "capabilityIds"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "displayName": { "$ref": "#/$defs/displayName" },
        "capacity": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "capabilityIds": { "$ref": "#/$defs/idArray" },
        "availablePeriodIds": { "$ref": "#/$defs/idArray" }
      }
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName", "weekday", "order"],
      "dependentRequired": {
        "startTime": ["endTime"],
        "endTime": ["startTime"]
      },
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "displayName": { "$ref": "#/$defs/displayName" },
        "weekday": {
          "enum": ["MONDAY", "TUESDAY", "WEDNESDAY", "THURSDAY", "FRIDAY", "SATURDAY", "SUNDAY"]
        },
        "order": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "startTime": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9](:[0-5][0-9])?$" },
        "endTime": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9](:[0-5][0-9])?$" }
      }
    },
    "lesson": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName", "subjectId", "cohortId", "teacherId"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "displayName": { "$ref": "#/$defs/displayName" },
        "subjectId": { "$ref": "#/$defs/id" },
        "cohortId": { "$ref": "#/$defs/id" },
        "teacherId": { "$ref": "#/$defs/id" },
        "seriesId": { "$ref": "#/$defs/id" },
        "requiredRoomCapabilityIds": { "$ref": "#/$defs/idArray" },
        "preferredRoomIds": { "$ref": "#/$defs/idArray" },
        "undesirablePeriodIds": { "$ref": "#/$defs/idArray" },
        "periodLock": { "$ref": "#/$defs/id" },
        "roomLock": { "$ref": "#/$defs/id" }
      }
    },
    "roomAssignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "subjectId"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "subjectId": { "$ref": "#/$defs/id" },
        "teacherId": { "$ref": "#/$defs/id" },
        "allowedRoomIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "useHomeRoom": { "const": true }
      },
      "oneOf": [
        { "required": ["allowedRoomIds"], "not": { "required": ["useHomeRoom"] } },
        { "required": ["useHomeRoom"], "not": { "required": ["allowedRoomIds"] } }
      ]
    },
    "softConstraintOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": ["constraintId", "weight"],
      "properties": {
        "constraintId": {
          "enum": [
            "soft.teacher-gap", "soft.cohort-gap", "soft.cohort-late-start", "soft.cohort-week-balance", "soft.series-same-day",
            "soft.undesirable-period", "soft.non-preferred-room"
          ]
        },
        "weight": { "type": "integer", "minimum": 0, "maximum": 1000000 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "catalogVersion": { "enum": [1, 2, 3, 4, 5, 6, 7, 8] } } },
      "then": { "not": { "required": ["roomAssignments"] } }
    },
    {
      "if": { "properties": { "catalogVersion": { "enum": [1, 2, 3, 4, 5, 6, 7] } } },
      "then": { "properties": {
        "cohorts": { "items": { "not": { "anyOf": [
          { "required": ["curatorTeacherId"] },
          { "required": ["homeRoomId"] }
        ] } } },
        "subjects": { "items": { "not": { "required": ["curatorLesson"] } } }
      } }
    },
    {
      "if": { "properties": { "catalogVersion": { "enum": [1, 2, 3, 4, 5, 6] } } },
      "then": { "properties": { "cohorts": { "items": {
        "not": { "required": ["dailyLessonSpreadLimit"] }
      } } } }
    },
    {
      "if": { "properties": { "catalogVersion": { "enum": [1, 2, 3, 4, 5] } } },
      "then": { "properties": {
        "cohorts": { "items": { "not": { "anyOf": [
          { "required": ["latestStartSlot"] },
          { "required": ["preferredLatestStartSlot"] }
        ] } } },
        "subjects": { "items": { "not": { "anyOf": [
          { "required": ["reservedPeriodsAllowed"] },
          { "required": ["maxWeeklyReservedLessonsPerCohort"] },
          { "required": ["dayEdgeOnly"] },
          { "required": ["maxDailyLessonsPerCohort"] }
        ] } } }
      } }
    },
    {
      "if": { "properties": { "catalogVersion": { "enum": [1, 2, 3, 4] } } },
      "then": { "properties": { "cohorts": { "items": {
        "not": { "required": ["maxDailyGaps"] }
      } } } }
    },
    {
      "if": { "properties": { "catalogVersion": { "enum": [1, 2, 3] } } },
      "then": { "properties": { "cohorts": { "items": {
        "not": { "required": ["maxDailyLessonSpread"] }
      } } } }
    },
    {
      "if": { "properties": { "catalogVersion": { "const": 1 } } },
      "then": { "properties": { "softConstraintOverrides": { "items": { "properties": {
        "constraintId": { "enum": ["soft.teacher-gap", "soft.series-same-day", "soft.undesirable-period", "soft.non-preferred-room"] }
      } } } } }
    },
    {
      "if": { "properties": { "catalogVersion": { "const": 2 } } },
      "then": { "properties": { "softConstraintOverrides": { "items": { "properties": {
        "constraintId": { "enum": ["soft.teacher-gap", "soft.cohort-gap", "soft.cohort-week-balance", "soft.series-same-day", "soft.undesirable-period", "soft.non-preferred-room"] }
      } } } } }
    }
  ]
}
