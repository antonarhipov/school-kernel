+package org.schoolkernel.workspace;
+
+import java.io.IOException;
+import jakarta.servlet.http.HttpServletRequest;
+import org.springframework.beans.factory.annotation.Value;
+import org.springframework.context.annotation.Profile;
+import org.springframework.http.HttpHeaders;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.bind.annotation.*;
+import tools.jackson.databind.JsonNode;
+import tools.jackson.databind.ObjectMapper;
+
+@RestController
+@Profile("demo")
+class DemoDefinitionController {
+    private final WorkspaceStore store;
+    private final WorkspaceMutation mutation;
+    private final DemoDefinitionLimits limits;
+    private final DemoVerificationService verification;
+    private final WorkspaceController workspace;
+    private final ObjectMapper json;
+    private final int threshold, quick, thorough;
+
+    DemoDefinitionController(WorkspaceStore store, WorkspaceMutation mutation, DemoDefinitionLimits limits,
+            DemoVerificationService verification, WorkspaceController workspace, ObjectMapper json,
+            @Value("${demo.search.lesson-threshold:200}") int threshold,
+            @Value("${demo.search.quick-seconds:5}") int quick,
+            @Value("${demo.search.thorough-seconds:60}") int thorough) {
+        this.store = store; this.mutation = mutation; this.limits = limits; this.verification = verification;
+        this.workspace = workspace; this.json = json; this.threshold = threshold; this.quick = quick; this.thorough = thorough;
+    }
+
+    @PostMapping(value = "/api/demo/definition", consumes = "text/plain")
+    ResponseEntity<JsonNode> use(HttpServletRequest request,
+            @RequestHeader(value = HttpHeaders.IF_MATCH, required = false) String ifMatch,
+            @RequestHeader(value = "X-Demo-Confirmed", defaultValue = "false") boolean confirmed,
+            @RequestHeader(value = "X-Demo-Source", defaultValue = "custom") String source) throws IOException {
+        var current = store.load();
+        long version = ImportService.requireMatchingVersion(ifMatch, current);
+        if (current.activeRunId() != null || current.state() == WorkspaceState.SOLVING_INITIAL || current.state() == WorkspaceState.SOLVING_REPAIR)
+            throw new WorkspaceProblem(HttpStatus.CONFLICT, "INVALID_WORKSPACE_TRANSITION", "Wait for or cancel the active run first. The definition was not used.");
+        if (current.state() != WorkspaceState.EMPTY && !confirmed) throw new WorkspaceProblem(HttpStatus.PRECONDITION_REQUIRED,
+                "REPLACEMENT_CONFIRMATION_REQUIRED", "Confirm replacing all existing workspace work first. Export Current to keep it.");
+        if (request.getContentLengthLong() > DemoDefinitionLimits.DOCUMENT_BYTES)
+            throw new WorkspaceProblem(HttpStatus.PAYLOAD_TOO_LARGE, "DEFINITION_TOO_LARGE", "The definition must be at most 2 MiB UTF-8. It was not used.");
+        var definition = limits.read(request.getInputStream());
+        var trusted = verification.verify(new ImportDocuments(definition, null, null, ImportDocuments.ImportMode.INITIAL_DEFINITION));
+        var document = json.createObjectNode();
+        document.putObject("school").put("id", trusted.schoolId()).put("displayName", definition.path("displayName").asString());
+        document.put("importMode", "INITIAL_DEFINITION");
+        // Only fixed public sample identifiers or file/custom origins are retained; labels never cross this API.
+        document.put("origin", java.util.Set.of("small", "two-class", "full", "file").contains(source) ? source : "custom");
+        document.put("definitionRevision", trusted.definitionRevision());
+        document.set("initialDefinition", definition);
+        boolean large = definition.path("lessons").size() > threshold;
+        document.put("defaultEffort", large ? "THOROUGH" : "QUICK");
+        document.put("defaultEffortSeconds", large ? thorough : quick);
+        return workspace.response(mutation.resetAndImport(version, WorkspaceState.INITIAL_DRAFT, document));
+    }
+}
--- a/timetable-workspace/src/main/java/org/schoolkernel/workspace/DemoDefinitionLimits.java
+++ b/timetable-workspace/src/main/java/org/schoolkernel/workspace/DemoDefinitionLimits.java
@@ -0,0 +1,88 @@
+package org.schoolkernel.workspace;
+
+import java.io.IOException;
+import java.io.InputStream;
+import java.util.List;
+import org.springframework.beans.factory.annotation.Value;
+import org.springframework.context.annotation.Profile;
+import org.springframework.http.HttpStatus;
+import org.springframework.stereotype.Component;
+import tools.jackson.core.JacksonException;
+import tools.jackson.databind.DeserializationFeature;
+import tools.jackson.databind.JsonNode;
+import tools.jackson.databind.json.JsonMapper;
+
+@Component
+@Profile("demo")
+class DemoDefinitionLimits {
+    static final int DOCUMENT_BYTES = 2 * 1024 * 1024;
+    private static final JsonMapper JSON = JsonMapper.builder()
+            .enable(DeserializationFeature.FAIL_ON_READING_DUP_TREE_KEY)
+            .enable(DeserializationFeature.FAIL_ON_TRAILING_TOKENS).build();
+    private final long workMax;
+    private final int lessonMax;
+    private final com.networknt.schema.Schema schema;
+
+    DemoDefinitionLimits(@Value("${demo.complexity.work-max:11000000}") long workMax,
+            @Value("${demo.complexity.lesson-max:2500}") int lessonMax) {
+        if (workMax < 1 || lessonMax < 1) throw new IllegalArgumentException("Positive demo complexity limits required");
+        this.workMax = workMax;
+        this.lessonMax = lessonMax;
+        try (var input = getClass().getResourceAsStream("/schema/school-definition-v1.schema.json")) {
+            schema = com.networknt.schema.SchemaRegistry.withDefaultDialect(com.networknt.schema.SpecificationVersion.DRAFT_2020_12).getSchema(input);
+            schema.initializeValidators();
+        } catch (IOException exception) { throw new IllegalStateException("Definition schema missing", exception); }
+    }
+
+    JsonNode read(InputStream input) throws IOException {
+        byte[] bytes = input.readNBytes(DOCUMENT_BYTES + 1);
+        if (bytes.length > DOCUMENT_BYTES) throw new WorkspaceProblem(HttpStatus.PAYLOAD_TOO_LARGE,
+                "DEFINITION_TOO_LARGE", "The definition must be at most 2 MiB UTF-8. It was not used.");
+        JsonNode definition;
+        try {
+            String text = java.nio.charset.StandardCharsets.UTF_8.newDecoder()
+                    .onMalformedInput(java.nio.charset.CodingErrorAction.REPORT)
+                    .onUnmappableCharacter(java.nio.charset.CodingErrorAction.REPORT)
+                    .decode(java.nio.ByteBuffer.wrap(bytes)).toString();
+            definition = JSON.readTree(text);
+        }
+        catch (JacksonException | java.nio.charset.CharacterCodingException exception) {
+            throw invalid("/", "Expected one valid JSON object without duplicate fields or trailing content.");
+        }
+        check(definition);
+        return definition;
+    }
+
+    void check(JsonNode definition) {
+        if (definition == null || !definition.isObject()) throw invalid("/", "Expected a definition object.");
+        for (String field : List.of("subjects", "teachers", "cohorts", "rooms", "periods", "lessons")) {
+            if (!definition.path(field).isArray()) throw invalid("/" + field, "Expected an array.");
+            int index = 0;
+            for (JsonNode item : definition.path(field)) {
+                if (!item.isObject()) throw invalid("/" + field + "/" + index, "Expected an object.");
+                index++;
+            }
+        }
+        // Divide before multiplying; neither overflow nor malformed arrays can bypass either gate.
+        long lessons = definition.path("lessons").size();
+        long periods = definition.path("periods").size(), rooms = definition.path("rooms").size();
+        if (lessons > lessonMax || lessons != 0 && periods > workMax / lessons
+                || lessons != 0 && periods != 0 && rooms > workMax / (lessons * periods)) {
+            throw new WorkspaceProblem(HttpStatus.UNPROCESSABLE_ENTITY, "DEFINITION_COMPLEXITY_LIMIT",
+                    "/lessons, /periods, /rooms: This definition exceeds the demo complexity limit (at most "
+                    + lessonMax + " lessons and placement work " + workMax + "). It was not used.");
+        }
+        if (definition.has("basedOnRevision")) throw invalid("/basedOnRevision",
+                "An initial definition must omit repair ancestry. Use a complete accepted bundle to retain a repaired timetable.");
+        var errors = schema.validate(definition);
+        if (!errors.isEmpty()) {
+            var error = errors.stream().sorted(java.util.Comparator.comparing(e -> e.getInstanceLocation().toString())).findFirst().orElseThrow();
+            throw invalid(error.getInstanceLocation().toString(), error.getMessage());
+        }
+    }
+
+    private static WorkspaceProblem invalid(String location, String message) {
+        return new WorkspaceProblem(HttpStatus.UNPROCESSABLE_ENTITY, "INVALID_INITIAL_DEFINITION",
+                location + ": " + message + " The definition was not used.");
+    }
+}
