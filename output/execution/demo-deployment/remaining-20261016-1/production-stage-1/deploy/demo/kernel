#!/bin/sh
set -eu
umask 077
case "${1:-}" in
  verify) heap_mb=${DEMO_VERIFY_HEAP_MB:-256} ;;
  *) heap_mb=${DEMO_SOLVER_HEAP_MB:-1024} ;;
esac
case "$heap_mb" in ''|*[!0-9]*|0) echo 'Demo kernel heap must be a positive integer' >&2; exit 64;; esac
exec java "-Xmx${heap_mb}m" -XX:ActiveProcessorCount=2 -jar /opt/demo/kernel.jar "$@"
