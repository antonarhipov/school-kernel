<configuration>
  <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
  <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>
  <appender name="DEMO_JSON" class="ch.qos.logback.core.ConsoleAppender">
    <encoder><pattern>%msg%n</pattern></encoder>
  </appender>
  <logger name="DemoEvents" level="INFO" additivity="false"><appender-ref ref="DEMO_JSON"/></logger>
  <logger name="org.apache.tomcat.util.net.NioEndpoint.certificate" level="WARN"/>
  <root level="INFO"><appender-ref ref="CONSOLE"/></root>
</configuration>
