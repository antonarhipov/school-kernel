+export const preferenceGuide = [
+  { id:'soft.teacher-gap', since:1, name:'Reduce teacher gaps', group:'Daily rhythm',
+    effect:'Encourage compact teaching days for teachers.',
+    counting:'Each unoccupied available regular slot between the first and last taught slots within a contiguous availability block adds 1 penalty unit. Unavailable slots split the blocks. Unoccupied reserved periods are excluded; time before the first or after the last lesson adds no gap penalty.',
+    example:'A teacher teaches regular slots 1 and 3, and slot 2 is available and empty: 1 penalty unit.', units:1,
+    related:'Teachers → Availability determines the available blocks. Grid defines the regular and reserved slots.' },
+  { id:'soft.cohort-gap', since:2, name:'Reduce class gaps', group:'Daily rhythm',
+    effect:'Encourage compact school days for classes.',
+    counting:'Each unoccupied available regular slot between the first and last taught slots within a contiguous availability block adds 1 penalty unit. Unavailable slots split the blocks. Unoccupied reserved periods are excluded; time before the first or after the last lesson adds no gap penalty.',
+    example:'A class has lessons in regular slots 1 and 3, and slot 2 is available and empty: 1 penalty unit.', units:1,
+    related:'Classes → Availability determines the available blocks. This preference does not penalize late starts; Reduce class late starts handles those separately.' },
+  { id:'soft.cohort-late-start', since:3, name:'Reduce class late starts', group:'Daily rhythm',
+    effect:'Encourage the first lesson of each class day to start by its preferred latest regular slot.',
+    counting:'A class day adds 1 penalty unit when the number of regular catalog slots before its first lesson is at least its preferred latest start slot. Reserved periods do not count; earlier regular slots count even if unavailable. Starting several slots later still adds just 1 unit for that day.',
+    example:'Preferred latest start is regular slot 2, but the first lesson is in regular slot 3: 1 penalty unit.', units:1,
+    related:'Classes → Day shape → Preferred latest start slot sets the soft target. The separate hard Latest start slot remains binding.' },
+  { id:'soft.cohort-week-balance', since:2, name:'Balance class days', group:'Teaching spread',
+    effect:'Encourage a more even lesson load across the week, using each class’s preferred daily spread.',
+    counting:'Count lessons on every weekday with at least one available regular slot, including days with zero lessons. For every pair of these weekdays, add max(absolute lesson-count difference − preferred daily spread, 0). Sum all pairs for the class.',
+    example:'Two days have 3 and 5 lessons, with preferred daily spread 1: this pair adds max(2 − 1, 0) = 1 penalty unit. Other weekday pairs contribute separately.', units:1,
+    related:'Classes → Day shape → Preferred daily spread sets the soft target. The separate hard Daily lesson spread limit remains binding.' },
+  { id:'soft.series-same-day', since:1, name:'Spread a series across days', group:'Teaching spread',
+    effect:'Encourage weekly occurrences in the same series to use different weekdays.',
+    counting:'For each series on each weekday, every occurrence after the first adds 1 penalty unit: max(count − 1, 0). Ungrouped lessons do not contribute. This creates neither an adjacency requirement nor a hard one-per-day rule.',
+    example:'3 occurrences of the same series on Monday: 2 penalty units.', units:2,
+    related:'Weekly requirements define series. Occurrence details → Series membership controls whether lessons belong to a series.' },
+  { id:'soft.undesirable-period', since:1, name:'Avoid undesirable periods', group:'Placement comfort',
+    effect:'Encourage lessons to avoid slots marked undesirable for their teacher, class or individual occurrence.',
+    counting:'Each matching teacher, class and occurrence declaration adds 1 penalty unit for the lesson, up to 3 units at the same slot. An undesirable period is still available unless a separate hard availability rule excludes it.',
+    example:'The teacher and class both mark the assigned slot undesirable: 2 penalty units for that lesson.', units:2,
+    related:'Teachers and Classes → Availability, and Occurrence details → Scheduling choices set undesirable periods. Undesirable and unavailable are separate choices.' },
+  { id:'soft.non-preferred-room', since:1, name:'Favor preferred rooms', group:'Placement comfort',
+    effect:'Encourage lessons to use a room from their effective preferred-room set.',
+    counting:'Each lesson assigned outside a nonempty effective preferred-room set adds 1 penalty unit. Omitted or explicitly empty occurrence preferences use the class home-room fallback when the home room fits the class size and required capabilities. An empty effective set adds no penalty. Capacity, capabilities, room policies, availability and persistent locks still apply.',
+    example:'A lesson prefers rooms A and B, but uses another eligible room C: 1 penalty unit.', units:1,
+    related:'Weekly requirements and Occurrence details set preferred rooms. Classes → Home room supplies the eligible fallback; Room policies set hard requirements.' }
+];
+export const validPreferenceWeight = value => typeof value === 'number' && Number.isSafeInteger(value) && value >= 0 && value <= 1000000;
