+        if (next >= 0) { event.preventDefault(); for (const choice of buttons) choice.tabIndex = -1; buttons[next].tabIndex = 0; buttons[next].focus(); }
+      }); buttons.push(button);
+      if (columns) { for (const column of columns) { const cell = el('td'); if (column.key === 'name') cell.append(button); else cell.textContent = column.value(row); container.append(cell); } }
+      else { button.append(el('span', row.summary, 'definition-record-summary')); if (row.issues.length) button.append(el('span', `${row.issues.filter(issue => issue.severity === 'BLOCKING').length} blocking · ${row.issues.filter(issue => issue.severity !== 'BLOCKING').length} advisories`, 'definition-issue-badge')); container.append(button); }
